#. module: flousflow_documents
#. odoo-python
#: code:addons/flousflow_documents/models/document.py:0
msgid "Delete Forever"
msgstr "حذف نهائي"

#. module: flousflow_documents
#. odoo-python
#: code:addons/flousflow_documents/models/document.py:0
msgid "Only the user who locked the document or a manager can unlock it."
msgstr "فقط المستخدم الذي قفل المستند أو المدير يمكنه فتح القفل."

#. module: flousflow_documents
#. odoo-python
#: code:addons/flousflow_documents/models/document.py:0
msgid "Only trashed documents can be permanently deleted."
msgstr "يمكن حذف المستندات الموجودة في السلة فقط نهائياً."

#. module: flousflow_documents
#. odoo-python
#: code:addons/flousflow_documents/models/document.py:0
msgid "A file document must have an attachment. Upload a file first."
msgstr "يجب أن يحتوي مستند الملف على مرفق. ارفع ملفاً أولاً."

#. module: flousflow_documents
#. odoo-python
#: code:addons/flousflow_documents/models/document.py:0
msgid "Only documents of type 'folder' can be used as parent."
msgstr "فقط المستندات من نوع 'مجلد' يمكن استخدامها كمجموعة أب."

#. module: flousflow_documents
#. odoo-python
#: code:addons/flousflow_documents/models/document_operation.py:0
msgid "Please select a destination folder."
msgstr "الرجاء اختيار المجلد الوجهة."

#. module: flousflow_documents
#. odoo-python
#: code:addons/flousflow_documents/models/document_operation.py:0
msgid "A folder cannot be moved into itself."
msgstr "لا يمكن نقل المجلد إلى داخله."

#. module: flousflow_documents
#. odoo-python
#: code:addons/flousflow_documents/models/document_sharing.py:0
msgid "Hello,<br/>A document has been shared with you."
msgstr "مرحباً،<br/>تمت مشاركة مستند معك."

#. module: flousflow_documents
#. odoo-python
#: code:addons/flousflow_documents/models/document_sharing.py:0
msgid "A document has been shared with you."
msgstr "تمت مشاركة مستند معك."

#. module: flousflow_documents
#. odoo-python
#: code:addons/flousflow_documents/models/document_sharing.py:0
msgid "The link access is more permissive than the internal access rights. Do you really want to continue?"
msgstr "الوصول عبر الرابط أكثر سماحاً من صلاحيات الوصول الداخلية. هل تريد حقاً المتابعة؟"

#. module: flousflow_documents
#. odoo-python
#: code:addons/flousflow_documents/models/document_sharing.py:0
