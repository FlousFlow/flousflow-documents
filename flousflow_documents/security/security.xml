<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- Groups (Odoo 19: res.groups.privilege + privilege_id)       -->
    <!-- ============================================================ -->
    <record id="module_category_documents" model="ir.module.category">
        <field name="name">Documents</field>
        <field name="sequence">50</field>
    </record>

    <record id="privilege_documents" model="res.groups.privilege">
        <field name="name">Documents</field>
        <field name="sequence">50</field>
        <field name="category_id" ref="module_category_documents"/>
    </record>

    <record id="group_documents_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_documents"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_documents_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="privilege_documents"/>
        <field name="implied_ids" eval="[(4, ref('group_documents_user'))]"/>
    </record>

    <record id="group_documents_system" model="res.groups">
        <field name="name">System Administrator</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="privilege_documents"/>
        <field name="implied_ids" eval="[(4, ref('group_documents_manager'))]"/>
    </record>

    <!-- ============================================================ -->
    <!-- Record rules (mirror the Odoo Enterprise permission model)   -->
    <!-- ============================================================ -->
    <data noupdate="1">
        <!-- flousflow.document -->
        <record id="rule_document_read" model="ir.rule">
            <field name="name">Documents.document: global read rule</field>
            <field name="model_id" ref="model_flousflow_document"/>
            <field name="domain_force">[('user_permission', '!=', 'none')]</field>
            <field name="global" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_document_create" model="ir.rule">
            <field name="name">Documents.document: global create rule</field>
            <field name="model_id" ref="model_flousflow_document"/>
            <field name="domain_force">[
                '|', ('folder_id.user_permission', '=', 'edit'),
                     ('folder_id', '=', False)
            ]</field>
            <field name="global" eval="True"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_document_write" model="ir.rule">
            <field name="name">Documents.document: global write rule</field>
            <field name="model_id" ref="model_flousflow_document"/>
            <field name="domain_force">[('user_permission', '=', 'edit')]</field>
            <field name="global" eval="True"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_document_write_unlink_base" model="ir.rule">
            <field name="name">Documents.document: write+unlink base rule</field>
            <field name="model_id" ref="model_flousflow_document"/>
            <field name="domain_force">[
                ('user_permission', '=', 'edit'),
                '|', ('type', '!=', 'folder'),
                     '|', ('owner_id', '!=', False),
                          ('folder_id', '!=', False)
            ]</field>
            <field name="groups" eval="[(4, ref('base.group_user')), (4, ref('base.group_portal')), (4, ref('base.group_public'))]"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_create" eval="False"/>
        </record>

        <record id="rule_document_write_unlink_manager" model="ir.rule">
            <field name="name">Documents.document: write+unlink manager rule</field>
            <field name="model_id" ref="model_flousflow_document"/>
            <field name="domain_force">[('user_permission', '=', 'edit')]</field>
            <field name="groups" eval="[(4, ref('group_documents_manager'))]"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_create" eval="False"/>
        </record>

        <!-- flousflow.document.access -->
        <record id="rule_document_access_read" model="ir.rule">
            <field name="name">Documents.access: global read rule</field>
            <field name="model_id" ref="model_flousflow_document_access"/>
            <field name="domain_force">[('document_id.user_permission', '!=', 'none')]</field>
            <field name="global" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_document_access_write" model="ir.rule">
            <field name="name">Documents.access: global write rule</field>
            <field name="model_id" ref="model_flousflow_document_access"/>
            <field name="domain_force">[('document_id.user_permission', '=', 'edit')]</field>
            <field name="global" eval="True"/>
            <field name="perm_read" eval="False"/>
        </record>

        <!-- flousflow.document.tag -->
        <record id="rule_tag_portal_read" model="ir.rule">
            <field name="name">Tag portal: Read access to the tags of the documents the user has access to</field>
            <field name="model_id" ref="model_flousflow_document_tag"/>
            <field name="domain_force">[('document_ids.user_permission', '!=', 'none')]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
