<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_document_tag_form" model="ir.ui.view">
        <field name="name">flousflow.document.tag.form</field>
        <field name="model">flousflow.document.tag</field>
        <field name="arch" type="xml">
            <form string="Tag">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="color" widget="color_picker"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="tooltip"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_document_tag_list" model="ir.ui.view">
        <field name="name">flousflow.document.tag.list</field>
        <field name="model">flousflow.document.tag</field>
        <field name="arch" type="xml">
            <list string="Tags" editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker" optional="hide"/>
                <field name="sequence"/>
                <field name="tooltip" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_document_tag_search" model="ir.ui.view">
        <field name="name">tag search</field>
        <field name="model">flousflow.document.tag</field>
        <field name="arch" type="xml">
            <search string="Search Tags">
                <field name="name"/>
                <group>
                    <filter name="group_documents" string="Document" context="{'group_by':'document_ids'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_document_tag" model="ir.actions.act_window">
        <field name="name">Tags</field>
        <field name="res_model">flousflow.document.tag</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'simple_name': True}</field>
    </record>
</odoo>
