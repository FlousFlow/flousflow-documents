<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Daily purge of trashed documents past their deletion date -->
        <record id="cron_delete_trashed_documents" model="ir.cron">
            <field name="name">Documents: purge trashed documents</field>
            <field name="model_id" ref="model_flousflow_document"/>
            <field name="state">code</field>
            <field name="code">model._cron_delete_trashed()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
